# ==============================================================================
# .env 文件示例（请勿直接使用！）
# 使用步骤：
# 1. 复制此文件，重命名为 .env
# 2. 将占位符（your_xxx_here）替换为真实值
# 3. .env 文件已在 .gitignore 中，不会提交到Git
# ==============================================================================

# .env 文件内容
SECRET_KEY = your_secret_key_here

# SQLite 数据库配置（可选，留空则默认保存在 data/pan_relay.db，无需安装任何数据库软件）
# SQLITE_DB_PATH = data/pan_relay.db

# 管理员账号密码
ADMIN_USERNAME = your_admin_username_here
ADMIN_PASSWORD = your_admin_password_here

# Telegram 公开频道搜索
TG_SEARCH_ENABLED = true
TG_CHANNELS = tgsearchers7,tgsearchers3,tgsearchers6
TG_SEARCH_TIMEOUT = 10
TG_SEARCH_MAX_WORKERS = 4
# 服务器无法直连 t.me 时填写，例如 socks5://127.0.0.1:7890
TG_PROXY =
