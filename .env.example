# ==============================================================================
# .env 文件示例（请勿直接使用！）
# 使用步骤：
# 1. 复制此文件，重命名为 .env
# 2. 将占位符（your_xxx_here）替换为真实值
# 3. .env 文件已在 .gitignore 中，不会提交到 Git
# ==============================================================================

# 应用密钥与鉴权
SECRET_KEY = your_secret_key_here

# SQLite 数据库配置（可选，留空则默认保存在 data/pan_relay.db，无需安装任何数据库软件）
# SQLITE_DB_PATH = data/pan_relay.db

# 管理员账号密码（留空或未配置时默认: admin / admin123）
ADMIN_USERNAME = admin
ADMIN_PASSWORD = admin123

# ==============================================================================
# 服务通道与 Web UI 开关配置 (环境变量覆盖优先级高于数据库配置)
# ==============================================================================
# 独立控制前台 Web 搜索界面 (ENABLE_FRONTEND)：设置为 false/0 时禁用前台搜索界面 (访客访问根路径 GET / 自动重定向至后台登录页 /login)
# ENABLE_FRONTEND = true

# 独立控制后台 Web 管理界面 (ENABLE_ADMIN_UI)：设置为 false/0 时禁用后台界面 (访问 /admin/* 返回 403 禁用提示)
# ENABLE_ADMIN_UI = true

# API 搜索默认检索作用域 (SEARCH_API_SCOPE / DEFAULT_SEARCH_SCOPE)：
# own: 仅检索站长收益库资源 (0 服务器开销、毫秒级响应)
# all: 全网并发聚合检索 (兼顾全网数据源)
# SEARCH_API_SCOPE = own

# API 转存鉴权密钥 (TRANSFER_API_KEY / RELAY_API_KEY)：
# 留空表示 POST /api/v1/transfer 接口公开开放；若设置字符串凭证，客户端需携带 Header "X-API-Key: <KEY>" 或 Bearer Token
# TRANSFER_API_KEY = 

# Telegram 公开频道搜索的频道、开关、代理、超时和并发数，请在管理后台
# 「搜索源 → Telegram 频道」中配置；首次启动会自动写入内置默认值。
