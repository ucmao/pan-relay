# ==============================================================================
# .env 文件示例（请勿直接使用！）
# 使用步骤：
# 1. 复制此文件，重命名为 .env
# 2. 将占位符（your_xxx_here）替换为真实值
# 3. .env 文件已在 .gitignore 中，不会提交到 Git
# ==============================================================================

# 应用密钥与会话安全 (生产环境请务必修改为随机复杂字符串)
SECRET_KEY = your_secret_key_here

# SQLite 数据库配置（可选，留空则默认保存在 data/pan_relay.db，无需安装任何数据库软件）
# SQLITE_DB_PATH = data/pan_relay.db

# 管理员初始化账号密码（首次启动自动创建，默认: admin / admin123）
ADMIN_USERNAME = admin
ADMIN_PASSWORD = admin123

# ==============================================================================
# 业务功能与网盘配置说明：
# 所有网盘凭证 (Cookie / Token)、前台搜索页开关、API 搜索范围与鉴权 Key、
# 搜索源插件及 Telegram 频道等，均统一在管理后台可视化界面中配置管理，
# 支持热更新与免重启即时生效！
# 后台地址：http://localhost:5000/login
# ==============================================================================

# ==============================================================================
# 出站网络代理（可选，留空直连）
# 格式：协议://[用户名:密码@]主机:端口，协议支持 http / https / socks5 / socks5h
# 住宅代理网关示例：http://user:pass@gw.example.com:7777（每次检测自动换出口 IP）
# 以下三项也可在管理后台修改；后台保存过后以后台配置为准。
# 配置了代理时请求一律经代理发出，代理不可用直接报错，不会回退直连。
# 插件搜索、网盘转存与账号保活不走这些代理。
# ==============================================================================
# 网盘链接测活（前台测活、开放 API 测活、转存前置测活、资源库巡检）  后台：系统配置 → 搜索与风控 → 测活网络代理
# LINK_CHECK_PROXY = http://user:pass@gw.example.com:7777
# API 接口搜索源与接口测试                          后台：搜索源 → 搜索调度参数设置
# API_PROXY = http://user:pass@gw.example.com:7777
# Telegram 频道抓取（国内服务器访问 TG 通常需要）      后台：搜索源 → 搜索调度参数设置
# TG_PROXY = socks5h://127.0.0.1:7890
